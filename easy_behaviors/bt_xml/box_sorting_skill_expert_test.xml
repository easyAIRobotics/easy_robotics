<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="main_tree">
    <Sequence>
      <TriggerGripper active="False"/>
      <Fallback>
        <ObjectSelector input_type="box"
                        output_type="{selected_container}"
                        selected_bbox="{selected_bbox}"/>
        <ForceFailure>
          <Sequence>
            <TriggerGripper active="False"/>
            <Sleep msec="15000"/>
            <Reset/>
          </Sequence>
        </ForceFailure>
      </Fallback>
      <Fallback>
        <Sequence>
          <Counter key="policy_pick_total"
                   increment="1"
                   count="{policy_pick_total_count}"/>
          <Sleep msec="1000"/>
          <TimeCounter key="pick_policy"
                       switch="start"
                       input_time="0.0"
                       output_time="{pick_start}"/>
          <Timeout msec="60000">
            <Policy bbox="{selected_bbox}"
                    skill="pick"
                    mode="expert"/>
          </Timeout>
          <Counter key="policy_pick_success"
                   increment="1"
                   count="{policy_pick_success_count}"/>
          <TimeCounter key="pick_policy"
                       switch="stop"
                       input_time="{pick_start}"
                       output_time="{pick_end}"/>
        </Sequence>
        <ForceFailure>
          <Homing where="home"/>
        </ForceFailure>
      </Fallback>
      <Sequence>
        <Sleep msec="500"/>
        <ObjectSelector input_type="{selected_container}"
                        output_type="{selected_container_2}"
                        selected_bbox="{selected_bbox}"/>
      </Sequence>
      <Fallback>
        <Sequence>
          <Counter key="policy_place_total"
                   increment="1"
                   count="{policy_place_total_count}"/>
          <TimeCounter key="place_policy"
                       switch="start"
                       input_time="0.0"
                       output_time="{place_start}"/>
          <Sleep msec="1000"/>
          <Timeout msec="60000">
            <Policy bbox="{selected_bbox}"
                    skill="place"
                    mode="expert"/>
          </Timeout>
          <Counter key="policy_place_success"
                   increment="1"
                   count="{policy_place_success_count}"/>
          <TimeCounter key="place_policy"
                       switch="stop"
                       input_time="{place_start}"
                       output_time="{place_end}"/>
        </Sequence>
        <ForceFailure>
          <Sequence>
            <Homing where="home"/>
            <TriggerGripper active="False"/>
          </Sequence>
        </ForceFailure>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Counter">
      <input_port name="key"/>
      <input_port name="increment"/>
      <output_port name="count"/>
    </Action>
    <Action ID="Homing">
      <input_port name="where"/>
    </Action>
    <Action ID="ObjectSelector">
      <input_port name="input_type"/>
      <output_port name="output_type"/>
      <output_port name="selected_bbox"/>
    </Action>
    <Action ID="Policy">
      <input_port name="bbox"/>
      <input_port name="skill"/>
      <input_port name="mode"/>
    </Action>
    <Action ID="Reset"/>
    <Action ID="TimeCounter">
      <input_port name="key"/>
      <input_port name="switch"/>
      <input_port name="input_time"/>
      <output_port name="output_time"/>
    </Action>
    <Action ID="TriggerGripper">
      <input_port name="active"/>
    </Action>
  </TreeNodesModel>

</root>
