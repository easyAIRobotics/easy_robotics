<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="suction_gripper">
    <xacro:macro name="suction_gripper" params="prefix">
        <link name="$(arg prefix)suction_gripper_base">
            <inertial>
                <mass value="0.2" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia
                    ixx="0.0001" ixy="0.0" ixz="0.0"
                    iyy="0.0001" iyz="0.0"
                    izz="0.0001" />
            </inertial>
            <visual>
                <origin xyz="0 0 0.05" rpy="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find easy_simulation)/urdf/suction_gripper.stl"
                        scale="1.5 1.5 3.0" />
                </geometry>
                <material name="gray">
                    <color rgba="0.5 0.5 0.5 1.0" />
                </material>
            </visual>
            <collision name="gripper">
                <origin xyz="0 0 0.05" rpy="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find easy_simulation)/urdf/suction_gripper.stl"
                        scale="1.5 1.5 3.0" />
                </geometry>
            </collision>
        </link>

        <joint name="$(arg prefix)suction_gripper_joint" type="fixed">
            <parent link="$(arg prefix)end_effector_link" />
            <child link="$(arg prefix)suction_gripper_base" />
            <origin xyz="0 0 0.05" rpy="0 0 0" />
        </joint>

        <link name="virtual_suction_tip" />
        <joint name="virtual_suction_tip_joint" type="fixed">
            <parent link="$(arg prefix)suction_gripper_base" />
            <child link="virtual_suction_tip" />
            <origin xyz="0 0 0.05" rpy="0 0 0" />
        </joint>

        <xacro:macro name="contact_sensor" params="parent_link sensor_name collision_name">
            <gazebo reference="${parent_link}">
                <sensor name="${sensor_name}" type="contact">
                    <contact>
                        <collision>${collision_name}</collision>
                    </contact>
                </sensor>
            </gazebo>
        </xacro:macro>

        <xacro:contact_sensor parent_link="$(arg prefix)suction_gripper_base" sensor_name="$(arg prefix)suction_contact_sensor" collision_name="gripper" />
        <xacro:contact_sensor parent_link="$(arg prefix)base_link" sensor_name="$(arg prefix)base_link_contact_sensor" collision_name="base_link_collision" />
        <xacro:contact_sensor parent_link="$(arg prefix)shoulder_link" sensor_name="$(arg prefix)shoulder_link_contact_sensor" collision_name="shoulder_link_collision" />
        <xacro:contact_sensor parent_link="$(arg prefix)arm_link" sensor_name="$(arg prefix)arm_link_contact_sensor" collision_name="arm_link_collision" />
        <xacro:contact_sensor parent_link="$(arg prefix)forearm_link" sensor_name="$(arg prefix)forearm_link_contact_sensor" collision_name="forearm_link_collision" />
        <xacro:contact_sensor parent_link="$(arg prefix)lower_wrist_link" sensor_name="$(arg prefix)lower_wrist_link_contact_sensor" collision_name="lower_wrist_link_collision" />
        <xacro:contact_sensor parent_link="$(arg prefix)upper_wrist_link" sensor_name="$(arg prefix)upper_wrist_link_contact_sensor" collision_name="upper_wrist_link_collision" />        

        <gazebo>
            <plugin
                filename="easy_simulation_plugins"
                name="easy_simulation_plugins::SuctionGripperPlugin">
            </plugin>
            <plugin filename="gz-sim-touchplugin-system"
                    name="gz::sim::systems::TouchPlugin">
                <target>box1</target>
                <namespace>suction_gripper</namespace>
                <time>0.001</time>
                <enabled>true</enabled>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>