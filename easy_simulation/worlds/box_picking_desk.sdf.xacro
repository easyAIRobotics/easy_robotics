    <xacro:macro name="box" params="name origin">
      <include>
        <uri>file:///$(find easy_simulation)/worlds/models/cardboard_box</uri>
        <name>${name}</name>
        <pose>${origin}</pose>
      </include>
    </xacro:macro>

    <xacro:macro name="target_box" params="name origin">
      <include>
        <uri>file:///$(find easy_simulation)/worlds/models/cardboard_box_green</uri>
        <name>${name}</name>
        <pose>${origin}</pose>
      </include>
    </xacro:macro>

    <xacro:macro name="storage_bin" params="name origin">
