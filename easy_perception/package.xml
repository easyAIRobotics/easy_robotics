<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easy_perception</name>
  <version>0.0.0</version>
  <description>Computer vision models and perception pipelines for robotics</description>
  <maintainer email="dinhhoangdung0712@gmail.com">Hoang Dung Dinh</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>easy_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>usb_cam</depend>

  <!-- Python packages -->
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
